VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Strava OAuth client id -- safe to expose client-side, this is only
# ever used to build the redirect to Strava's own consent screen. The
# client secret half of the exchange lives only as an edge function
# secret (STRAVA_CLIENT_SECRET, set via `supabase secrets set`), never
# here and never in any client bundle.
VITE_STRAVA_CLIENT_ID=your-strava-client-id

# Rest timer push (v1.14.0). Generate a key pair once with
#   npx web-push generate-vapid-keys
# The public key is safe client-side; the private key, QStash token and
# shared secret go only in Vercel project env vars (server-side).
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
# Server-only (Vercel env vars, not this file in production):
# VAPID_PRIVATE_KEY=your-vapid-private-key
# VAPID_SUBJECT=mailto:you@example.com
# QSTASH_TOKEN=your-upstash-qstash-token
# PUSH_SEND_SECRET=any-long-random-string
